+/* Read only the physical FEXT subtrees whose key ranges can contain private_id.
+ * Every recursive call must descend one level. The caller owns the result array,
+ * including any extents already appended if a later node fails validation. */
+static int sealed_extent_node(
+     libfsapfs_file_system_btree_t *tree, libbfio_handle_t *io,
+     uint64_t block, int expected_level, uint64_t private_id,
+     libcdata_array_t *extents, uint64_t *last_end, libcerror_error_t **error )
+{
+	libfsapfs_btree_node_t *node = NULL;
+	libfsapfs_file_extent_t *extent = NULL;
+	const uint32_t block_size = tree->io_handle->block_size;
+	const uint64_t blocks = tree->io_handle->container_size / block_size;
+	uint64_t checksum, stored, oid, previous_id = 0, previous_offset = 0;
+	uint8_t *data = NULL;
+	int count, result = -1;
+
+	if( !block || block >= blocks || block > INT64_MAX / block_size )
+		goto done;
+	data = memory_allocate( block_size );
+	if( !data || libbfio_handle_read_buffer_at_offset( io, data, block_size,
+	     (off64_t)( block * block_size ), error ) != (ssize_t) block_size )
+		goto done;
+	byte_stream_copy_to_uint64_little_endian( data, stored );
+	byte_stream_copy_to_uint64_little_endian( data + 8, oid );
+	if( oid != block || libfsapfs_checksum_calculate_fletcher64(
+	     &checksum, data + 8, block_size - 8, 0, error ) != 1 || checksum != stored )
+		goto done;
+	if( libfsapfs_btree_node_initialize( &node, error ) != 1 ||
+	    libfsapfs_btree_node_read_data( node, data, block_size, error ) != 1 )
+		goto done;
+	int root = expected_level < 0;
+	int level = node->node_header->level;
+	if( node->object_type != ( root ? 0x40000002UL : 0x40000003UL ) ||
+	    node->object_subtype != 0x1f || level > 16 || ( !root && level != expected_level ) ||
+	    node->node_header->flags != ( 4 | ( root ? 1 : 0 ) | ( level ? 0 : 2 ) ) ||
+	    libfsapfs_btree_node_get_number_of_entries( node, &count, error ) != 1 )
+		goto done;
+
+	uint64_t pending_child = 0;
+	for( int index = 0; index < count; index++ )
+	{
+		libfsapfs_btree_entry_t *entry = NULL;
+		uint64_t id, offset, value;
+		if( libfsapfs_btree_node_get_entry_by_index( node, index, &entry, error ) != 1 ||
+		    !entry || entry->key_data_size != 16 || entry->value_data_size != (level ? 8 : 16) )
+			goto done;
+		byte_stream_copy_to_uint64_little_endian( entry->key_data, id );
+		byte_stream_copy_to_uint64_little_endian( entry->key_data + 8, offset );
+		byte_stream_copy_to_uint64_little_endian( entry->value_data, value );
+		if( index && ( id < previous_id || ( id == previous_id && offset <= previous_offset ) ) )
+			goto done;
+		previous_id = id;
+		previous_offset = offset;
+		if( level )
+		{
+			/* Each separator is the minimum key in the corresponding child. */
+			if( pending_child && ( id > private_id || (id == private_id && offset) ) &&
+			    sealed_extent_node( tree, io, pending_child, level - 1,
+			     private_id, extents, last_end, error ) != 1 )
+				goto done;
+			pending_child = 0;
+			if( id > private_id ) break;
+			if( !value ) goto done;
+			pending_child = value;
+		}
+		else if( id == private_id )
+		{
+			uint64_t physical;
+			int array_index;
+			byte_stream_copy_to_uint64_little_endian( entry->value_data + 8, physical );
+			if( !value || value >> 56 || value % block_size || offset % block_size ||
+			    offset < *last_end || value > INT64_MAX || offset > INT64_MAX - value ||
+			    physical >= blocks || value / block_size > blocks - physical )
+				goto done;
+			if( libfsapfs_file_extent_initialize( &extent, error ) != 1 ) goto done;
+			extent->logical_offset = offset;
+			extent->physical_block_number = physical;
+			extent->data_size = value;
+			if( libcdata_array_append_entry( extents, &array_index, (intptr_t *) extent, error ) != 1 )
+				goto done;
+			extent = NULL;
+			*last_end = offset + value;
+		}
+	}
+	if( pending_child && sealed_extent_node( tree, io, pending_child, level - 1,
+	    private_id, extents, last_end, error ) != 1 )
+		goto done;
+	result = 1;
+done:
+	if( extent ) libfsapfs_file_extent_free( &extent, NULL );
+	if( node ) libfsapfs_btree_node_free( &node, NULL );
+	if( data ) memory_free( data );
+	return result;
+}
+
+static int sealed_get_extents(
+     libfsapfs_file_system_btree_t *tree, libbfio_handle_t *io, uint64_t private_id,
+     libcdata_array_t *extents, libcerror_error_t **error )
+{
+	uint64_t last_end = 0;
+	if( sealed_extent_node( tree, io, tree->fext_root, -1, private_id, extents,
+	     &last_end, error ) != 1 )
+	{
+		libcerror_error_set( error, LIBCERROR_ERROR_DOMAIN_IO, LIBCERROR_IO_ERROR_READ_FAILED,
+		 "Unable to traverse sealed volume file extent tree." );
+		return -1;
+	}
+	return last_end ? 1 : 0;
+}
